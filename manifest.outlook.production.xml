<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
  xsi:type="MailApp">
  <Id>c6757210-1130-437c-b839-13a5dbdf23ad</Id>
  <Version>1.0.0.2</Version>
  <ProviderName>ClassifyMe</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ClassifyMe"/>
  <Description DefaultValue="Manual email and meeting classification MVP for Outlook compose mode."/>
  <IconUrl DefaultValue="https://your-org.github.io/your-repo/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://your-org.github.io/your-repo/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://your-org.github.io/your-repo/"/>
  <AppDomains>
    <AppDomain>https://your-org.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://your-org.github.io/your-repo/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="ClassifyMeComposeGroup">
                <Label resid="CommandsGroup.Label"/>
                <Control xsi:type="Button" id="ClassifyMeComposeTaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="ClassifyMeAppointmentComposeGroup">
                <Label resid="CommandsGroup.Label"/>
                <Control xsi:type="Button" id="ClassifyMeAppointmentComposeTaskpaneButton">
                  <Label resid="ApptTaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="ApptTaskpaneButton.Label"/>
                    <Description resid="ApptTaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://your-org.github.io/your-repo/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://your-org.github.io/your-repo/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://your-org.github.io/your-repo/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://your-org.github.io/your-repo/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://your-org.github.io/your-repo/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CommandsGroup.Label" DefaultValue="ClassifyMe"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Classify email"/>
        <bt:String id="ApptTaskpaneButton.Label" DefaultValue="Classify meeting"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open ClassifyMe to classify this email"/>
        <bt:String id="ApptTaskpaneButton.Tooltip" DefaultValue="Open ClassifyMe to classify this meeting"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
