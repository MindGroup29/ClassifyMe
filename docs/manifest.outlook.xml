<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
  xsi:type="MailApp">
  <Id>c0decafe-beef-face-acde-c0ffee000002</Id>
  <Version>1.0.0.7</Version>
  <ProviderName>ClassifyMe</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="ClassifyMe DEV"/>
  <Description DefaultValue="Classification manuelle des e-mails et réunions dans Outlook."/>
  <IconUrl DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.contoso.com/help"/>
  <AppDomains>
    <AppDomain>https://www.contoso.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://MindGroup29.github.io/ClassifyMe/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="ClassifyMeComposeGroup">
                <Label resid="CommandsGroup.Label"/>
                <Control xsi:type="Button" id="ClassifyMeComposeTaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="ClassifyMeAppointmentComposeGroup">
                <Label resid="CommandsGroup.Label"/>
                <Control xsi:type="Button" id="ClassifyMeAppointmentComposeTaskpaneButton">
                  <Label resid="ApptTaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="ApptTaskpaneButton.Label"/>
                    <Description resid="ApptTaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://MindGroup29.github.io/ClassifyMe/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://MindGroup29.github.io/ClassifyMe/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CommandsGroup.Label" DefaultValue="ClassifyMe DEV"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Classifier l&apos;e-mail DEV"/>
        <bt:String id="ApptTaskpaneButton.Label" DefaultValue="Classifier la réunion DEV"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Ouvrir ClassifyMe DEV pour classifier cet e-mail"/>
        <bt:String id="ApptTaskpaneButton.Tooltip" DefaultValue="Ouvrir ClassifyMe DEV pour classifier cette réunion"/>
      </bt:LongStrings>
    </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Reminder.Runtime.Url">
              <!-- Outlook Classic Windows charge directement ce bundle JavaScript. -->
              <Override type="javascript" resid="Reminder.Runtime.Js"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ClassifyMeComposeGroup">
                  <Label resid="CommandsGroup.Label"/>
                  <Control xsi:type="Button" id="ClassifyMeComposeTaskpaneButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ClassifyMeAppointmentComposeGroup">
                  <Label resid="CommandsGroup.Label"/>
                  <Control xsi:type="Button" id="ClassifyMeAppointmentComposeTaskpaneButton">
                    <Label resid="ApptTaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="ApptTaskpaneButton.Label"/>
                      <Description resid="ApptTaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageCompose"/>
                <LaunchEvent Type="OnNewAppointmentOrganizer" FunctionName="onNewAppointmentOrganizer"/>
              </LaunchEvents>
              <SourceLocation resid="Reminder.Runtime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://MindGroup29.github.io/ClassifyMe/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://MindGroup29.github.io/ClassifyMe/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://MindGroup29.github.io/ClassifyMe/taskpane.html"/>
          <bt:Url id="Reminder.Runtime.Url" DefaultValue="https://MindGroup29.github.io/ClassifyMe/outlook-classification-reminder.html?v=1.0.0.7"/>
          <bt:Url id="Reminder.Runtime.Js" DefaultValue="https://MindGroup29.github.io/ClassifyMe/outlook-classification-reminder.js?v=1.0.0.7"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="CommandsGroup.Label" DefaultValue="ClassifyMe DEV"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Classifier l&apos;e-mail DEV"/>
          <bt:String id="ApptTaskpaneButton.Label" DefaultValue="Classifier la réunion DEV"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Ouvrir ClassifyMe DEV pour classifier cet e-mail"/>
          <bt:String id="ApptTaskpaneButton.Tooltip" DefaultValue="Ouvrir ClassifyMe DEV pour classifier cette réunion"/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
